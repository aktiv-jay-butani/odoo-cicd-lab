<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_odoo_ai_knowledge_chunk_tree" model="ir.ui.view">
        <field name="name">odoo.ai.knowledge.chunk.list</field>
        <field name="model">odoo.ai.knowledge.chunk</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="source_type"/>
                <field name="module_name"/>
                <field name="source_path"/>
                <field name="embedding_provider"/>
                <field name="is_embedded"/>
                <field name="active"/>
            </list>
        </field>
    </record>

    <record id="view_odoo_ai_knowledge_chunk_form" model="ir.ui.view">
        <field name="name">odoo.ai.knowledge.chunk.form</field>
        <field name="model">odoo.ai.knowledge.chunk</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_generate_embedding" string="Generate Embedding" type="object" class="btn-primary"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="source_type"/>
                            <field name="module_name"/>
                            <field name="version"/>
                        </group>
                        <group>
                            <field name="source_path"/>
                            <field name="embedding_provider"/>
                            <field name="embedding_model"/>
                            <field name="embedding_dimension"/>
                            <field name="is_embedded"/>
                            <field name="active"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Content">
                            <field name="content" nolabel="1"/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_odoo_ai_knowledge_chunk" model="ir.actions.act_window">
        <field name="name">Knowledge Chunks</field>
        <field name="res_model">odoo.ai.knowledge.chunk</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
