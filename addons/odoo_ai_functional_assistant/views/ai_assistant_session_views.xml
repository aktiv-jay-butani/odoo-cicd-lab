<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_odoo_ai_assistant_session_tree" model="ir.ui.view">
        <field name="name">odoo.ai.assistant.session.list</field>
        <field name="model">odoo.ai.assistant.session</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="question"/>
                <field name="model"/>
                <field name="top_k"/>
                <field name="create_date"/>
            </list>
        </field>
    </record>

    <record id="view_odoo_ai_assistant_session_form" model="ir.ui.view">
        <field name="name">odoo.ai.assistant.session.form</field>
        <field name="model">odoo.ai.assistant.session</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_ask_assistant" string="Ask Assistant" type="object" class="btn-primary"/>
                </header>
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="model"/>
                        <field name="top_k"/>
                    </group>
                    <group>
                        <field name="question" placeholder="Example: How do I configure 3-step delivery in Odoo 19?"/>
                    </group>
                    <notebook>
                        <page string="Answer">
                            <field name="answer" nolabel="1" readonly="1"/>
                        </page>
                        <page string="Retrieved Context">
                            <field name="context_summary" nolabel="1" readonly="1"/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="action_odoo_ai_assistant_session" model="ir.actions.act_window">
        <field name="name">Ask Assistant</field>
        <field name="res_model">odoo.ai.assistant.session</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>

