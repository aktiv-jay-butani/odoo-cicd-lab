<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form_odoo_ai_assistant" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.odoo.ai.assistant</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="base.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//form" position="inside">
                <app data-string="Odoo AI Assistant" string="Odoo AI Assistant" name="odoo_ai_functional_assistant">
                    <block title="AI Provider">
                        <setting string="Provider">
                            <field name="odoo_ai_provider"/>
                        </setting>
                        <setting string="OpenAI API Key">
                            <field name="odoo_ai_openai_api_key" password="True"/>
                        </setting>
                        <setting string="Gemini API Key">
                            <field name="odoo_ai_gemini_api_key" password="True"/>
                        </setting>
                        <setting string="Embedding Model">
                            <field name="odoo_ai_embedding_model"/>
                        </setting>
                        <setting string="Chat Model">
                            <field name="odoo_ai_chat_model"/>
                        </setting>
                    </block>
                </app>
            </xpath>
        </field>
    </record>
</odoo>
